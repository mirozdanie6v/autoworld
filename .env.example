# AUTO MIR / AUTO SALE server integrations.
# Never expose private tokens in browser-side code.
AUTO_SALE_TELEGRAM_BOT_TOKEN=
# Optional comma-separated Telegram numeric user/chat IDs that receive unassigned/new lead notifications.
AUTO_SALE_MANAGER_CHAT_IDS=

# VK Mini App integration. Keep disabled until all production credentials are configured.
AUTO_SALE_VK_ENABLED=false
AUTO_SALE_VK_APP_ID=
AUTO_SALE_VK_APP_SECRET=
AUTO_SALE_VK_GROUP_ID=
AUTO_SALE_VK_COMMUNITY_TOKEN=
AUTO_SALE_VK_API_VERSION=5.199
