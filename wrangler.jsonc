{
  "$schema":"./node_modules/wrangler/config-schema.json",
  "name":"auto-sale-usa",
  "main":"src/auto-sale-worker.ts",
  "compatibility_date":"2026-08-25",
  "workers_dev":true,
  "assets":{"directory":"./dist","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":["/api/*"]},
  "d1_databases":[{"binding":"DB","database_name":"auto-sale-db","migrations_dir":"migrations"}],
  "vars":{"PRODUCT_MODE":"auto-sale-usa","AUTO_SALE_DEMO_MODE":"1"},
  "observability":{"enabled":true}
}
