{
  "name": "autoworld-georgia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "node scripts/build-autoworld.mjs",
    "test": "node --test tests/auto-sale*.test.mjs tests/ydb*.test.mjs tests/yandex-state-sync.test.mjs tests/object-storage.test.mjs tests/migration-backup.test.mjs tests/postgres-runtime.test.mjs tests/s3-storage.test.mjs tests/timeweb-provision.test.mjs tests/awg-price-safe-import.test.mjs",
    "test:relay": "npm --prefix cloudflare/telegram-relay test",
    "check": "npm run check:browser-syntax && npm run clean && npm run build && npm test && npm run test:relay",
    "start:yandex": "node server/yandex-server.mjs",
    "migrate:yandex": "node scripts/migrate-auto-sale-to-ydb.mjs",
    "test:yandex": "node --test tests/yandex-state-sync.test.mjs",
    "prepare:ydb-domain": "node scripts/prepare-auto-sale-ydb-domain.mjs",
    "backfill:ydb-domain": "node scripts/backfill-auto-sale-ydb-domain.mjs",
    "prepare:ydb-runtime": "node scripts/prepare-auto-sale-ydb-runtime.mjs",
    "initialize:ydb-domain": "node scripts/initialize-auto-sale-ydb-domain.mjs",
    "ensure:production-team": "node scripts/ensure-auto-sale-production-team.mjs",
    "check:browser-syntax": "node scripts/check-browser-syntax.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1150.0",
    "@ydbjs/auth": "latest",
    "@ydbjs/core": "latest",
    "@ydbjs/query": "latest",
    "@ydbjs/value": "latest",
    "pg": "8.23.1",
    "@ydbjs/api": "6.0.7",
    "@bufbuild/protobuf": "2.12.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "jsdom": "latest"
  }
}
