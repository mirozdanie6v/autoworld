FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY . .
RUN npm run build

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production PORT=8080
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts
COPY --from=build --chown=node:node /app/dist ./dist
COPY --from=build --chown=node:node /app/public/auto-sale-quote-audit.mjs ./public/auto-sale-quote-audit.mjs
COPY --from=build --chown=node:node /app/public/auto-sale-georgia-quote.mjs ./public/auto-sale-georgia-quote.mjs
COPY --from=build --chown=node:node /app/public/auto-sale-quote-v2.mjs ./public/auto-sale-quote-v2.mjs
COPY --from=build --chown=node:node /app/public/auto-sale-catalog-lead.mjs ./public/auto-sale-catalog-lead.mjs
COPY --from=build --chown=node:node /app/public/auto-sale-payment-balance.mjs ./public/auto-sale-payment-balance.mjs
COPY --chown=node:node server ./server
COPY --chown=node:node shared ./shared
COPY --chown=node:node scripts ./scripts
USER node
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 CMD node -e "fetch('http://127.0.0.1:8080/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node","server/yandex-server.mjs"]
