FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY server/awg-visitor-telemetry-server.mjs server/awg-visitor-analytics-store.mjs server/telegram-bot.mjs server/vk.mjs ./server/
COPY shared/auto-sale-notification-links.mjs shared/awg-visitor-analytics.mjs ./shared/
COPY public/auto-sale-georgia-quote.mjs ./public/
EXPOSE 8080
USER node
CMD ["node","server/awg-visitor-telemetry-server.mjs"]
